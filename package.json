{
  "name": "hyperframe",
  "private": true,
  "version": "0.2.51",
  "description": "HyperFrame — Análise e dimensionamento estrutural para edifícios de concreto armado (normas ABNT)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @hyperframe/desktop",
    "build": "npm run build -w @hyperframe/desktop",
    "build:web": "npm run build:web -w @hyperframe/desktop",
    "serve:web": "node scripts/serve-web.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "tauri": "npm run tauri -w @hyperframe/desktop --"
  }
}
